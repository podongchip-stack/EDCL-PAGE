rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isApproved() {
      return signedIn() && hasUserDoc()
        && userData(request.auth.uid).status == 'approved';
    }

    function isAdmin() {
      return signedIn() && hasUserDoc()
        && userData(request.auth.uid).role == 'admin';
    }

    match /users/{uid} {
      // 본인 문서는 항상 읽기 가능, 승인된 구성원은 명단 조회 가능(담당자 지정 등)
      allow read: if signedIn() && (request.auth.uid == uid || isApproved() || isAdmin());
      // 가입 시 본인 문서 생성: 반드시 member / pending 으로만 시작하고,
      // email은 Auth 토큰의 이메일과 일치해야 한다(승인 화면 스푸핑 방지)
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'member'
        && request.resource.data.status == 'pending'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'status', 'createdAt']);
      // 본인은 name만 수정 가능(role/status/email 불변), 관리자만 승인·역할 변경 가능
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']));
      allow delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if isApproved();
      allow create: if isApproved() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isApproved()
        && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    match /projects/{projectId} {
      allow read: if isApproved();
      allow create: if isApproved() && request.resource.data.createdBy == request.auth.uid;
      // 작성자/관리자만 수정 가능, createdBy는 변경 불가(소유권 탈취 방지)
      allow update: if isApproved()
        && (resource.data.createdBy == request.auth.uid || isAdmin())
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isApproved()
        && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    match /tasks/{taskId} {
      allow read: if isApproved();
      allow create: if isApproved() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isApproved();
    }

    match /notices/{noticeId} {
      // 공지는 관리자만 작성·수정·삭제
      allow read: if isApproved();
      allow create: if isAdmin() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /resources/{resourceId} {
      allow read: if isApproved();
      allow create: if isApproved() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isApproved()
        && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // 공개 논문 목록: 누구나 읽기, 승인된 구성원이 관리
    match /publications/{pubId} {
      allow read: if true;
      allow create: if isApproved() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isApproved();
    }

    // 공개 구성원 프로필: visible=true인 문서만 공개.
    // 쓰기는 "승인된 본인" 또는 관리자만 — 미승인/강퇴 계정이 공개 페이지에
    // 자신을 등록하는 것을 막는다.
    match /publicProfiles/{uid} {
      allow read: if resource.data.visible == true
        || (signedIn() && (request.auth.uid == uid || isAdmin()));
      allow create, update: if ((isApproved() && request.auth.uid == uid) || isAdmin())
        && request.resource.data.keys().hasOnly(
          ['name', 'position', 'interests', 'isAlumni', 'visible', 'updatedAt']
        );
      allow delete: if (isApproved() && request.auth.uid == uid) || isAdmin();
    }

    // 공개 랜딩 페이지 문구: 누구나 읽기, 관리자만 편집
    match /siteContent/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 예약 항목(회의실/장비): 관리자만 관리
    match /bookableItems/{itemId} {
      allow read: if isApproved();
      allow create, update, delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read: if isApproved();
      // date는 YYYY-MM-DD 형식이어야 한다 (형식이 깨지면 어떤 목록에도 안 잡히는 유령 예약이 됨)
      allow create: if isApproved()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      allow update, delete: if isApproved()
        && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // 순번(세미나 발표/당번): 관리자만 관리
    match /rotations/{rotationId} {
      allow read: if isApproved();
      allow create, update, delete: if isAdmin();
    }

    // 공개 소식: 누구나 읽기, 관리자만 작성
    match /news/{newsId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 내부 회의록
    match /meetingNotes/{noteId} {
      allow read: if isApproved();
      allow create: if isApproved() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isApproved()
        && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // 저널클럽 논문 리딩 큐 (상태 변경은 구성원 누구나 — 작업과 동일한 협업 모델)
    // 단, createdBy는 변경 불가 — 소유권을 바꿔 작성자 전용 삭제 제한을 우회하지 못하게
    match /readings/{readingId} {
      allow read: if isApproved();
      allow create: if isApproved() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isApproved()
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isApproved()
        && (resource.data.createdBy == request.auth.uid || isAdmin());
    }
  }
}
